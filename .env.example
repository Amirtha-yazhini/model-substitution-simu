# Copy to .env and fill in. .env is gitignored - never commit it.
# All of these are FREE tiers. No credit card is required for any of them.
# Signup links and quota notes are in config/providers.yaml.

# --- Required: the two census workhorses ---
CEREBRAS_API_KEY=
GROQ_API_KEY=

# --- Required: first-party references (ground truth for RUT/KBF) ---
MISTRAL_API_KEY=
GOOGLE_API_KEY=

# --- Recommended: breadth + the A11 Auto Exacto arm ---
GITHUB_TOKEN=
OPENROUTER_API_KEY=

# --- Optional overflow (leave blank unless needed) ---
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
CF_ACCOUNT_ID=
