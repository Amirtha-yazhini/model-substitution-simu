# Secrets - NEVER commit
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Corpus: raw responses ARE committed (that is the point - see plan.md Phase 2),
# but the working scratch and oversized shards are not.
corpus/_scratch/
corpus/**/*.tmp

# Results: figures and tables are committed; raw live-run logs are not.
results/live_raw/

# OS
Thumbs.db
.DS_Store

# transient test ledgers
results/ledger_test.jsonl
results/ledger_http_test.jsonl
results/quota_state.json

# regenerable replay ledgers (40-60 MB each); grid.jsonl and tables are the record
results/ledger_grid.jsonl
results/ledger_probe.jsonl
results/ledger_thraudit.jsonl
results/ledger_eps.jsonl
